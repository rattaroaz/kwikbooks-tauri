# Copy to `.env` / `.env.local` for local overrides (never commit secrets).

# Set to false to hide dev-only tooling hooks even in development builds.
# VITE_ENABLE_DEVTOOLS=true

# Example gated UI experiments.
# VITE_FEATURE_EXPERIMENTAL_UI=false

# Reserved for opt-in client telemetry (off by default; nothing is sent in v1).
# VITE_TELEMETRY=false
