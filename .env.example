# Copy to `.env` or `.env.local` for local overrides. Never commit secrets.

# --- Frontend (Vite) ---
# Verbose IPC logging in the webview (default: on in dev).
# VITE_VERBOSE_IPC=true

# Forward browser console.* to host log files (default: on in dev; off in production builds).
# VITE_LOG_CONSOLE_FORWARD=true

# Warn when an IPC round-trip exceeds this many ms (default 1500; mirrors KWIKBOOKS_SLOW_MS on host).
# VITE_SLOW_IPC_MS=1500

# Opt-in telemetry hooks (default off; nothing is sent remotely in v1).
# VITE_TELEMETRY=false

# --- Host (Rust) — set in shell or OS env when running the desktop app ---
# KWIKBOOKS_LOG=debug
# KWIKBOOKS_LOG_JSON=1
# KWIKBOOKS_SLOW_MS=1500
