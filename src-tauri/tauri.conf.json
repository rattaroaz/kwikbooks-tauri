{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kwikbooks",
  "version": "0.9.0",
  "identifier": "com.kwikbooks.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kwikbooks",
        "width": 1024,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4RUY1NEQ3QkJGNENERkUKUldUK3pmUzcxMVR2ZU1yKzQvTTl3TkdRNDVTVlc4YWtodmgzc094M2pFZ2NEZFdTZk8zcDN1THkK",
      "endpoints": [
        "https://github.com/rattaroaz/kwikbooks-tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
